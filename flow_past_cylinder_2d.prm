subsection Mesh and discretization
  set Mesh file = ../mesh/ns-mesh2D-level0.msh
  set Velocity degree = 2
  set Pressure degree = 1
  set Final time = 0.50
  set Theta = 1.0
  set Time step = 0.01
end

subsection Solver
  set Nonlinear method = none
  set Nonlinear iterations = 2
  set Nonlinear tolerance = 1e-6
  set Picard relaxation = 1.0
  set GMRES restart length = 100
  set Pressure regularization = 0.0
  set Linear max iterations = 2000
  set Linear relative tolerance = 1e-1
  set Linear absolute tolerance = 1e-8
  set Preconditioner = yosida
end

subsection Stabilization
  set Temam = true
  set Grad-div = true
  set Grad-div coefficient = 1.0
  set SUPG = false
  set PSPG = false
end

subsection Physics
  set Viscosity = 0.5
  set Inlet velocity = 1.0
  set Outlet pressure = 0.0
end

subsection Force coefficients
  set Reference velocity = 1.0
  set Reference length = 25.0
end

subsection Boundary ids
  set Inlet = 1
  set Outlet = 2
  set Walls = 3
  set Cylinder = 5
end
